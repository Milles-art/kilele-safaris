# Copy this file to .env and fill in real values. Never commit .env.

# --- Security ---
# Generate a new one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=api.kilelesafaris.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://kilelesafaris.com,https://www.kilelesafaris.com

# --- CORS (the frontend origin) ---
CORS_ALLOWED_ORIGINS=https://kilelesafaris.com,https://www.kilelesafaris.com,http://localhost:5173

# --- Email (SMTP). Leave EMAIL_HOST empty to print emails to console (dev only). ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=hello@kilelesafaris.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kilele Safaris <hello@kilelesafaris.com>

# --- Business config ---
ADMIN_EMAIL=hello@kilelesafaris.com
ADMIN_SITE_URL=https://api.kilelesafaris.com
CONTACT_PHONE=+255 768 641 810

# --- Spam protection ---
# Max enquiries per IP per hour
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SECONDS=3600

# --- Backups ---
BACKUP_DIR=backups
